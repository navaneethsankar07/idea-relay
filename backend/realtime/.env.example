# Neon Realtime Gateway Service Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# JWT Secret shared with Django or dedicated Realtime signing key
JWT_SECRET=django-insecure-development-secret-key-change-in-production

# Neon Database Connection (for authorized subscriptions / query sealing)
# Example: postgres://user:password@ep-xyz.us-east-2.aws.neon.tech/idearelay?sslmode=require
NEON_DATABASE_URL=postgres://user:password@localhost:5432/idearelay

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
