# Django Backend Configuration
DEBUG=True
SECRET_KEY=django-insecure-development-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Database Configuration (Neon PostgreSQL or local PostgreSQL/SQLite fallback for local test)
# Example Neon URL: postgres://user:password@ep-xyz.us-east-2.aws.neon.tech/idearelay?sslmode=require
DATABASE_URL=sqlite:///db.sqlite3

# CORS & Frontend Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT Configuration
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7
